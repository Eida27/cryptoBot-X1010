# Admit only the inputs used by Dockerfile.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!uv.lock
!src/
!src/**
!config/
!config/**

# Keep local files out even when nested inside src or config.
**/.git
**/.venv
**/venv
**/.superpowers
**/.env*
**/*.pem
**/*.key
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/.pytest_cache
**/.hypothesis
**/.mypy_cache
**/.ruff_cache
**/.tox
**/.nox
**/build
**/dist
**/.coverage
**/.coverage.*
**/coverage.xml
**/htmlcov
**/tests
**/state
**/data
**/reports
**/backups
**/artifacts
**/logs
**/*.log
**/*.log.*
**/*.db
**/*.db-*
**/*.db.lock
**/*.sqlite
**/*.sqlite-*
**/*.sqlite.lock
**/*.sqlite3
**/*.sqlite3-*
**/*.sqlite3.lock
**/.DS_Store
**/Thumbs.db
**/desktop.ini
**/Desktop.ini
**/*.swp
**/*.swo
**/*~
